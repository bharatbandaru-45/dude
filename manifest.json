
{
  "manifest_version": 3,
  "name": "DUDE CONNECT",
  "version": "1.0",
  "description": "Connect Project Dude voice assistant to ChatGPT",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://bharatbandaru-45.github.io/dude/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bharatbandaru-45.github.io/dude/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
